{
  "name": "@fireflydle/api",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types --check && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply fireflydle --local"
  },
  "dependencies": {
    "@fireflydle/contracts": "workspace:*",
    "@fireflydle/game-data": "workspace:*",
    "@fireflydle/game-engine": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.118.0"
  }
}
