{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fireflydle-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_WEB_URL": "https://fireflydle.games",
    "CLOUDFLARE_ACCOUNT_ID": "a2755937171c4310b54c98acf0128861",
    "CLOUDFLARE_D1_DATABASE_ID": "93c0bbef-15d0-4431-9024-bfe1618e9f0e",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["account@fireflydle.games"],
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "OPS_METRICS",
      "dataset": "fireflydle_api_metrics",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fireflydle",
      "database_id": "93c0bbef-15d0-4431-9024-bfe1618e9f0e",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom",
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom", "Matchmaker"],
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
