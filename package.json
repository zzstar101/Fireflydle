{
  "name": "fireflydle",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici": "7.29.0"
  },
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev": "bun run --parallel dev:web dev:api",
    "build:web": "bun --cwd apps/web build && bun scripts/configure-web-shell.ts && bun scripts/prune-web-assets.ts && bun scripts/verify-web-artifact.ts",
    "build:api": "bun --cwd apps/api build",
    "build": "bun run --parallel build:web build:api",
    "verify": "bun run worker:types:check && bun run format:check && bun run typecheck && bun run assets:build && bun run assets:validate && bun run test && bun run build",
    "test:contracts": "bun --cwd packages/contracts test",
    "test:game-data": "bun --cwd packages/game-data test",
    "test:game-engine": "bun --cwd packages/game-engine test",
    "test:web": "bun --cwd apps/web test",
    "test:packages": "bun run --parallel test:contracts test:game-data test:game-engine",
    "test:apps": "bun run --parallel test:web test:worker test:assets",
    "test": "bun run validate:npc-census && bun run test:npc-manifest && bun run test:npc-content && bun run test:packages && bun run test:apps",
    "test:worker": "bun --cwd apps/api test",
    "typecheck:contracts": "bun --cwd packages/contracts typecheck",
    "typecheck:game-data": "bun --cwd packages/game-data typecheck",
    "typecheck:game-engine": "bun --cwd packages/game-engine typecheck",
    "typecheck:web": "bun --cwd apps/web typecheck",
    "typecheck:api": "bun --cwd apps/api typecheck",
    "typecheck:packages": "bun run typecheck:contracts && bun run --parallel typecheck:game-data typecheck:game-engine",
    "typecheck:apps": "bun run --parallel typecheck:web typecheck:api",
    "typecheck": "bun run typecheck:packages && bun run typecheck:apps",
    "worker:types": "bun --cwd apps/api types:generate",
    "worker:types:check": "bun --cwd apps/api types:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:data": "bun scripts/sync-characters.ts",
    "sync:content": "bun scripts/generate-content-manifest.ts",
    "sync:npc-census": "bun scripts/sync-npc-census.ts",
    "validate:npc-census": "bun scripts/validate-npc-census.ts",
    "test:npc-manifest": "bun test scripts/npc-manifest.test.ts",
    "test:npc-content": "bun run validate:npc-manifest && bun test scripts/validate-npc-manifest.test.ts",
    "validate:npc-manifest": "bun scripts/validate-npc-manifest.ts",
    "generate:assets": "bun scripts/generate-responsive-assets.ts",
    "assets:build": "bun scripts/generate-responsive-assets.ts",
    "assets:validate": "bun scripts/validate-assets.ts",
    "assets:upload": "bun scripts/upload-r2-assets.ts",
    "test:assets": "bun run assets:build && bunx vitest run scripts/responsive-assets.test.ts",
    "test:web-artifact": "bun scripts/verify-web-artifact.ts",
    "test:web-budget": "bun scripts/verify-web-bundle.ts",
    "deploy:api": "bun --cwd apps/api deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  }
}
